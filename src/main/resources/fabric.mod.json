{
    "schemaVersion": 1,
    "id": "craftingreimagined",
    "version": "${version}",
    "name": "Crafting Reimagined",
    "description": "A lightweight client-side Minecraft mod featuring a JEI-style recipe browser, automatic crafting, custom crafting quantities, MAX crafting, and missing-material indicator/panel.",
    "authors": [
      "v4jas2020"
    ],
    "contact": {
      "homepage": "https://modrinth.com/mod/crafting-reimagined",
      "sources": "https://github.com/v4jas2020/craftingreimagined"
    },
    "license": "LicenseRef-CraftingReimagined",
    "icon": "assets/craftingreimagined/icon.png",
    "environment": "client",
    "entrypoints": {
      "client": [
        "craftingreimagined.CraftingReimaginedClient"
      ]
    },
    "depends": {
      "fabricloader": ">=0.19.3",
      "minecraft": "~26.2",
      "java": ">=25",
      "fabric-api": "*"
    }
  }
// { originally I forgot to remove this extra { when I was editing the json to be updated, so now it stays as a relic.